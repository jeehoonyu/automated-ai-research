{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automated-ai-research.local/schemas/v1/document.schema.json",
  "title": "Document",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "document_id", "source_sha256", "media_type", "file_size", "original_storage_path", "import_aliases"],
  "properties": {
    "schema_name": {"const": "Document"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^DOC-sha256-[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "document_id": {"type": "string", "pattern": "^DOC-sha256-[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_type": {"enum": ["application/pdf", "text/markdown"]},
    "file_size": {"type": "integer", "minimum": 0},
    "original_storage_path": {"type": "string"},
    "import_aliases": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
