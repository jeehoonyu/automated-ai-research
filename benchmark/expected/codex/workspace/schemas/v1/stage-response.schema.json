{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageResponse",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "run_id", "stage", "outcome", "artifact_ids", "notes"],
  "properties": {
    "schema_name": {"const": "StageResponse"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "run_id": {"type": "string"},
    "stage": {"type": "string"},
    "outcome": {"enum": ["completed", "insufficient_evidence", "blocked", "failed"]},
    "artifact_ids": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
