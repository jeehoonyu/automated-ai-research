{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationResult",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "run_id", "passed", "report_eligible", "blocking_errors", "warnings", "human_review_requirements", "validated_artifact_hashes", "checks"],
  "properties": {
    "schema_name": {"const": "ValidationResult"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "run_id": {"type": "string"},
    "passed": {"type": "boolean"},
    "report_eligible": {"type": "boolean"},
    "blocking_errors": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "human_review_requirements": {"type": "array", "items": {"type": "object"}},
    "validated_artifact_hashes": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
