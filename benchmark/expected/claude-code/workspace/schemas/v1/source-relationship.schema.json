{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRelationship",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "relationship_id", "source_document_id", "related_document_id", "relationship_type", "relationship_evidence", "confidence", "human_review_status"],
  "properties": {
    "schema_name": {"const": "SourceRelationship"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "relationship_id": {"type": "string"},
    "source_document_id": {"type": "string"},
    "related_document_id": {"type": "string"},
    "relationship_type": {"enum": ["duplicate", "republication", "revision_of", "translation_of", "summarizes", "cites", "derived_from", "shares_primary_dataset", "shares_experimental_result", "unknown"]},
    "relationship_evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "human_review_status": {"type": "string"}
  },
  "additionalProperties": true
}
