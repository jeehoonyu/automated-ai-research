{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchPlan",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "run_id", "main_question", "subquestions", "definitions", "scope", "inclusion_criteria", "exclusion_criteria", "search_terms", "evidence_requirements", "validation_criteria", "expected_limitations", "high_risk_classifications", "insufficient_evidence_conditions"],
  "properties": {
    "schema_name": {"const": "ResearchPlan"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "run_id": {"type": "string"},
    "main_question": {"type": "string", "minLength": 1},
    "subquestions": {"type": "array", "items": {"type": "string"}},
    "definitions": {"type": "array", "items": {"type": "object"}},
    "scope": {"type": "object"},
    "inclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "exclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "search_terms": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "validation_criteria": {"type": "array", "items": {"type": "string"}},
    "expected_limitations": {"type": "array", "items": {"type": "string"}},
    "high_risk_classifications": {"type": "array", "items": {"type": "string"}},
    "insufficient_evidence_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
