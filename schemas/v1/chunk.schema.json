{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chunk",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "chunk_id", "document_id", "document_version_id", "page", "source_line_start", "source_line_end", "section_path", "start_offset", "end_offset", "exact_text", "text_sha256", "chunking_version", "chunking_configuration_hash", "index_eligible", "warnings"],
  "properties": {
    "schema_name": {"const": "Chunk"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^CHK-sha256-[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "chunk_id": {"type": "string"},
    "document_id": {"type": "string"},
    "document_version_id": {"type": "string"},
    "page": {"type": ["integer", "null"], "minimum": 1},
    "source_line_start": {"type": ["integer", "null"], "minimum": 1},
    "source_line_end": {"type": ["integer", "null"], "minimum": 1},
    "section_path": {"type": "array", "items": {"type": "string"}},
    "start_offset": {"type": "integer", "minimum": 0},
    "end_offset": {"type": "integer", "minimum": 0},
    "exact_text": {"type": "string"},
    "text_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "chunking_version": {"type": "string"},
    "chunking_configuration_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "index_eligible": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
