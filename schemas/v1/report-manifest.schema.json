{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportManifest",
  "type": "object",
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_hash", "created_at", "created_by", "report_manifest_id", "run_id", "draft", "report_path", "report_sha256", "validation_result_id", "input_artifact_hashes"],
  "properties": {
    "schema_name": {"const": "ReportManifest"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "report_manifest_id": {"type": "string"},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "run_id": {"type": "string"},
    "draft": {"type": "boolean"},
    "report_path": {"type": "string", "pattern": "^report/[A-Za-z0-9._-]+\\.md$"},
    "report_sha256": {"type": "string"},
    "validation_result_id": {"type": ["string", "null"]},
    "input_artifact_hashes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
