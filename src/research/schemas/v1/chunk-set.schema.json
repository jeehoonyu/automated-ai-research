{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.automated-ai-research.org/v1/chunk-set.schema.json",
  "title": "ChunkSet",
  "description": "Retrieval units for one document version. A chunk is not evidence.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "artifact_hash",
    "created_at",
    "created_by",
    "document_id",
    "document_version_id",
    "chunk_count",
    "chunks"
  ],
  "properties": {
    "schema_name": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "object",
      "required": [
        "actor_type"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "cli",
            "host_agent",
            "human"
          ]
        },
        "host": {
          "type": "string"
        },
        "model_identifier": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "reasoning_trace"
        ]
      }
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-sha256-[0-9a-f]{64}$"
    },
    "document_version_id": {
      "type": "string",
      "pattern": "^DVER-sha256-[0-9a-f]{64}$"
    },
    "normalized_text_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chunking_config": {
      "type": "object"
    },
    "chunking_config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0
    },
    "index_eligible_count": {
      "type": "integer",
      "minimum": 0
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "document_version_id",
          "text",
          "text_sha256",
          "start_offset",
          "end_offset",
          "index_eligible",
          "extraction_status"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^CHK-sha256-[0-9a-f]{64}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^DOC-sha256-[0-9a-f]{64}$"
          },
          "document_version_id": {
            "type": "string",
            "pattern": "^DVER-sha256-[0-9a-f]{64}$"
          },
          "text": {
            "type": "string"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "start_offset": {
            "type": "integer",
            "minimum": 0
          },
          "end_offset": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "line_end": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "section_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index_eligible": {
            "type": "boolean"
          },
          "extraction_status": {
            "enum": [
              "extracted",
              "partially_extracted",
              "ambiguous",
              "unsupported_format",
              "ocr_required",
              "processing_failed",
              "human_review_required"
            ]
          },
          "overlap_before": {
            "type": "integer",
            "minimum": 0
          },
          "overlap_after": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
